"use strict";


/* =========================================================
   ELEMENTS
========================================================= */

const filterButtons = document.querySelectorAll(".filter button");
const cards = document.querySelectorAll(".card");

const counters = document.querySelectorAll(".counter");

const overlay = document.getElementById("overlay");
const popup = document.getElementById("popup");
const closePopupButton = document.getElementById("closePopup");

const popAmount = document.getElementById("popAmount");


/* =========================================================
   FILTER CARDS
========================================================= */

filterButtons.forEach((button) => {

    button.addEventListener("click", () => {

        // Remove active state
        filterButtons.forEach((item) => {
            item.classList.remove("active");
        });

        // Add active state
        button.classList.add("active");

        const filter = button.dataset.filter;

        cards.forEach((card) => {

            const category = card.dataset.cat;

            const shouldShow =
                filter === "all" ||
                category === filter;

            card.style.display =
                shouldShow ? "" : "none";
        });

    });

});


/* =========================================================
   COUNTER ANIMATION
========================================================= */

const animateCounter = (element) => {

    const target = Number(
        element.dataset.target
    );

    if (!Number.isFinite(target)) {
        return;
    }

    let current = 0;

    const increment = Math.max(
        1,
        Math.floor(target / 60)
    );

    const interval = setInterval(() => {

        current += increment;

        if (current >= target) {

            element.textContent =
                target.toLocaleString("id-ID");

            clearInterval(interval);

            return;
        }

        element.textContent =
            current.toLocaleString("id-ID");

    }, 20);

};


counters.forEach(animateCounter);


/* =========================================================
   POPUP
========================================================= */

const amounts = [
    12500000,
    7200000,
    18500000,
    25000000
];


const getRandomAmount = () => {

    const randomIndex =
        Math.floor(
            Math.random() * amounts.length
        );

    return amounts[randomIndex];

};


const togglePopup = (show) => {

    if (!overlay || !popup) {
        return;
    }

    overlay.classList.toggle(
        "show",
        show
    );

    popup.classList.toggle(
        "show",
        show
    );

    overlay.setAttribute(
        "aria-hidden",
        String(!show)
    );

};


const updatePopupAmount = () => {

    if (!popAmount) {
        return;
    }

    popAmount.textContent =
        getRandomAmount().toLocaleString("id-ID");

};


const showRandomPopup = () => {

    updatePopupAmount();

    togglePopup(true);

    setTimeout(() => {
        togglePopup(false);
    }, 5500);

};


/* =========================================================
   POPUP EVENTS
========================================================= */

if (closePopupButton) {

    closePopupButton.addEventListener(
        "click",
        () => togglePopup(false)
    );

}


if (overlay) {

    overlay.addEventListener(
        "click",
        () => togglePopup(false)
    );

}


/* Close popup with ESC */
document.addEventListener(
    "keydown",
    (event) => {

        if (event.key === "Escape") {
            togglePopup(false);
        }

    }
);


/* =========================================================
   AUTOMATIC POPUP
========================================================= */

setInterval(
    showRandomPopup,
    18000
);


/* =========================================================
   EXIT INTENT
========================================================= */

let exitShown = false;

document.addEventListener(
    "mouseleave",
    (event) => {

        /*
         * Trigger when cursor leaves through
         * the top edge of the viewport.
         */
        if (
            event.clientY < 10 &&
            !exitShown
        ) {

            exitShown = true;

            showRandomPopup();
        }

    }
);
