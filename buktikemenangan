/* =========================================================
   ROOT
========================================================= */

:root {
    --bg: #070a12;
    --card: #0f1424;
    --gold: #f5c56b;
    --accent: #6be1ff;
    --danger: #ff5c7a;
    --text: #e9ecf1;
    --muted: #9aa3b2;
}


/* =========================================================
   RESET
========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", Arial, sans-serif;

    color: var(--text);

    background:
        radial-gradient(
            1200px 600px at 50% -10%,
            #1a2150 0%,
            transparent 60%
        ),
        var(--bg);

    min-height: 100vh;
}


/* =========================================================
   GENERAL
========================================================= */

img {
    max-width: 100%;
}

a {
    color: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

.container {
    width: 100%;
    max-width: 1100px;
    margin: auto;
    padding: 18px;
}


/* =========================================================
   HEADER
========================================================= */

header {
    position: sticky;
    top: 0;
    z-index: 50;

    backdrop-filter: blur(8px);

    background:
        linear-gradient(
            180deg,
            rgba(7, 10, 18, 0.85),
            rgba(7, 10, 18, 0.35)
        );

    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
}

.logo {
    width: 40px;
    height: 40px;

    overflow: hidden;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            #ffd98a,
            #b88a2e
        );

    box-shadow:
        0 10px 30px rgba(245, 197, 107, 0.35);

    animation:
        float 3s ease-in-out infinite;
}

.logo img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    border-radius: 12px;
}

.brand h1 {
    margin: 0;

    font-size: 18px;
    letter-spacing: 0.5px;
}


/* =========================================================
   CTA
========================================================= */

.cta {
    padding: 10px 14px;

    border-radius: 12px;

    font-weight: 700;
    text-decoration: none;

    background:
        linear-gradient(
            135deg,
            #6be1ff,
            #4aa3ff
        );

    color: #08121f;

    box-shadow:
        0 10px 30px rgba(107, 225, 255, 0.35);

    animation:
        pulse 2.5s infinite;
}


/* =========================================================
   HERO
========================================================= */

.hero {
    padding: 28px 0;
}

.hero-grid {
    display: grid;

    grid-template-columns:
        1.2fr
        0.8fr;

    gap: 18px;
}

.hero-card {
    padding: 20px;

    border-radius: 18px;

    background:
        linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.06),
            rgba(255, 255, 255, 0.02)
        );

    border: 1px solid rgba(255, 255, 255, 0.08);

    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.45);
}

.badge {
    display: inline-flex;

    align-items: center;
    gap: 8px;

    padding: 6px 10px;

    border-radius: 999px;

    background: rgba(107, 225, 255, 0.12);

    color: var(--accent);

    font-weight: 600;
}

.hero h2 {
    margin: 12px 0;

    font-size: 36px;
    line-height: 1.2;
}

.hero p {
    color: var(--muted);

    line-height: 1.6;
}


/* =========================================================
   STATS
========================================================= */

.stats {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;

    margin-top: 14px;
}

.stat {
    padding: 14px;

    border-radius: 14px;

    background: var(--card);

    border: 1px solid rgba(255, 255, 255, 0.06);
}

.stat b {
    font-size: 20px;
}

.counter {
    font-weight: 800;
    color: var(--gold);
}


/* =========================================================
   HERO VISUAL
========================================================= */

.hero-visual {
    overflow: hidden;

    border-radius: 18px;

    border: 1px solid rgba(255, 255, 255, 0.08);

    background:
        radial-gradient(
            600px 300px at 50% 0,
            rgba(245, 197, 107, 0.25),
            transparent 60%
        ),
        linear-gradient(
            180deg,
            #0b1030,
            #0a0f24
        );
}

.hero-visual .inner {
    padding: 22px;
}

.glow {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 10px;
}

.pill {
    padding: 10px;

    border-radius: 12px;

    background: rgba(245, 197, 107, 0.12);

    color: var(--gold);

    text-align: center;

    font-size: 13px;
    font-weight: 600;
}

.hero-image {
    margin-top: 16px;
}

.hero-image img {
    width: 100%;

    display: block;

    border-radius: 14px;

    box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.6);
}


/* =========================================================
   SAFE BADGE
========================================================= */

.safe {
    display: inline-block;

    padding: 6px 10px;

    border-radius: 999px;

    background: rgba(107, 225, 255, 0.12);

    color: var(--accent);

    font-weight: 600;
    font-size: 13px;
}


/* =========================================================
   SECTION
========================================================= */

section {
    padding: 26px 0;
}

.section-title {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 14px;
}

.section-title h3 {
    margin: 0;
}


/* =========================================================
   FILTER
========================================================= */

.filter {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;
}

.filter button {
    padding: 8px 12px;

    border-radius: 10px;

    border: 1px solid rgba(255, 255, 255, 0.08);

    background: var(--card);

    color: var(--text);

    cursor: pointer;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.filter button:hover {
    transform: translateY(-1px);
}

.filter button.active {
    background:
        linear-gradient(
            135deg,
            #ffd98a,
            #b88a2e
        );

    color: #1b1204;
}


/* =========================================================
   CARD GRID
========================================================= */

.grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 14px;
}

.card {
    overflow: hidden;

    border-radius: 16px;

    background: var(--card);

    border: 1px solid rgba(255, 255, 255, 0.06);

    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.45);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.card:hover {
    transform:
        translateY(-6px)
        scale(1.01);

    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.6);
}

.card img {
    width: 100%;

    display: block;
}

.card .meta {
    padding: 12px;
}

.amount {
    font-size: 22px;

    font-weight: 800;

    color: var(--gold);
}

.proof {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;

    margin-top: 8px;
}

.meta small {
    color: var(--muted);
}

.tag {
    padding: 6px 10px;

    border-radius: 999px;

    background: rgba(107, 225, 255, 0.12);

    color: var(--accent);

    font-size: 12px;
}


/* =========================================================
   FIXED CTA
========================================================= */

.fixed-cta {
    position: fixed;

    left: 0;
    right: 0;
    bottom: 0;

    padding: 12px;

    z-index: 60;

    background:
        linear-gradient(
            180deg,
            rgba(7, 10, 18, 0),
            rgba(7, 10, 18, 0.85)
        );
}

.fixed-cta .wrap {
    display: flex;

    gap: 10px;
}

.btn {
    flex: 1;

    display: block;

    padding: 14px;

    border-radius: 14px;

    text-align: center;

    font-weight: 800;

    text-decoration: none;
}

.btn.wa {
    background:
        linear-gradient(
            135deg,
            #4cff9a,
            #1ed760
        );

    color: #042410;
}

.btn.tg {
    background:
        linear-gradient(
            135deg,
            #6be1ff,
            #4aa3ff
        );

    color: #08121f;
}


/* =========================================================
   FOOTER
========================================================= */

footer {
    padding: 24px 0 110px;

    color: var(--muted);

    text-align: center;
}


/* =========================================================
   POPUP
========================================================= */

.overlay {
    position: fixed;

    inset: 0;

    display: none;

    background: rgba(0, 0, 0, 0.6);

    z-index: 80;
}

.overlay.show {
    display: block;
}

.popup {
    position: fixed;

    left: 50%;
    top: 50%;

    width: min(92%, 420px);

    padding: 18px;

    transform:
        translate(-50%, -50%);

    display: none;

    border-radius: 18px;

    background: var(--card);

    border: 1px solid rgba(255, 255, 255, 0.08);

    z-index: 90;

    box-shadow:
        0 30px 100px rgba(0, 0, 0, 0.6);
}

.popup.show {
    display: block;
}

.popup h4 {
    margin: 0 0 6px;
}

.popup p {
    color: var(--muted);

    line-height: 1.6;
}

.popup-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 10px;
}

.close {
    padding: 4px;

    border: 0;

    background: transparent;

    color: var(--text);

    font-size: 18px;

    cursor: pointer;

    opacity: 0.8;
}

.close:hover {
    opacity: 1;
}

.popup .row {
    display: flex;

    gap: 10px;

    margin-top: 10px;
}


/* =========================================================
   SLIDER
========================================================= */

.slider {
    overflow: hidden;

    width: 100%;

    margin-top: 14px;
}

.slides {
    display: flex;

    gap: 14px;

    animation:
        scroll 25s linear infinite;
}

.slides img {
    width: 260px;

    border-radius: 16px;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes scroll {
    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-50%);
    }
}

@keyframes float {
    0% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-6px);
    }

    100% {
        transform: translateY(0);
    }
}

@keyframes pulse {
    0% {
        box-shadow:
            0 0 0 0 rgba(245, 197, 107, 0.6);
    }

    70% {
        box-shadow:
            0 0 0 14px rgba(245, 197, 107, 0);
    }

    100% {
        box-shadow:
            0 0 0 0 rgba(245, 197, 107, 0);
    }
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .hero-grid {
        grid-template-columns: 1fr;
    }

    .grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 600px) {

    .container {
        padding: 14px;
    }

    .brand h1 {
        font-size: 16px;
    }

    .cta {
        padding: 8px 10px;

        font-size: 13px;
    }

    .hero h2 {
        font-size: 28px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .section-title {
        align-items: flex-start;

        flex-direction: column;
    }

    .glow {
        grid-template-columns: 1fr;
    }

    .proof {
        align-items: flex-start;

        flex-direction: column;
    }

    .fixed-cta {
        padding: 8px;
    }

    .fixed-cta .container {
        padding: 8px;
    }

    .btn {
        padding: 12px 8px;

        font-size: 13px;
    }

}


/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }

}
